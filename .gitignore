# Rust 构建产物（本机 target/ 约 2.3G，禁止入库）
/target

# 旧 BLOB 资产库遗留（当前架构已改用目录库；不要误提交）
/rpx.db
# 沙箱绕行构建目录（`.cargo-*` 锁文件被系统文件过滤按名拦截时的 CARGO_TARGET_DIR）
/.cargo-target

# 根目录散落调试日志
/_c.log
/_mut.log
/_t.log
/_test_base.txt
/_test_ws.log
/_v2.txt
/_audit_test.log
# scripts/gate.sh 的运行日志（可随时重跑，结论记 RUNLOG）
/_gate*.log

# tests/fixtures 下的临时探针产物
/tests/fixtures/_probe_mergepages.csv
/tests/fixtures/_probe_mergepages.rpx
/tests/fixtures/_shape_audit.py

# _bdo/ 只忽略编译副产物 —— out_jre8.txt / out_jdk21.txt 是 decimal_oracle 的
# 判据本身，必须入库（见 docs/code-review.md §3 G3-A、§1.1①）。
# ⛔ 曾经这里写的是整个 `/tests/fixtures/_bdo`，等于把判据一起忽略掉了，
#    导致 `cargo test` 的 3 条断言在新克隆上永久红。
/tests/fixtures/_bdo/*.class

# 编译后的 Java 探针产物
*.class
/out/

# ⛔ 数据源注册表（`serve --datasources <path.json>`）含真实连接串——金仓那件的
#   口令是明文的。曾经只有这条 `/out/`（指向一个并不存在的根目录），真正的产物
#   在 `tests/fixtures/out/`，等于**一次 `git add -A` 就把口令推上 GitHub**。
#   ⚠ tests/fixtures/out/ 是混合目录，39 个历史文件（讲座 HTML / 验证脚本 /
#   截图）是有意入库的 ⇒ ⛔ 不能整体忽略，只禁数据源注册表这一文件族。
/tests/fixtures/out/ds_*.json

# agent 沙箱写入垫片的残留（`<file>.<epoch-ms>.res`；2026-10-15 M6-05 实录：
# 沙箱内跑生成类测试留下的半成品/锁标记，非仓库资产）。
/tests/fixtures/out/*.res

