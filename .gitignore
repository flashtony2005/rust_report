# Rust 构建产物（本机 target/ 约 2.3G，禁止入库）
/target

# 根目录散落调试日志
/_c.log
/_mut.log
/_t.log
/_test_base.txt
/_test_ws.log
/_v2.txt

# tests/fixtures 下的临时探针产物
/tests/fixtures/_probe_mergepages.csv
/tests/fixtures/_probe_mergepages.rpx
/tests/fixtures/_shape_audit.py

# _bdo/ 只忽略编译副产物 —— out_jre8.txt / out_jdk21.txt 是 decimal_oracle 的
# 判据本身，必须入库（见 docs/code-review.md §3 G3-A、§1.1①）。
# ⛔ 曾经这里写的是整个 `/tests/fixtures/_bdo`，等于把判据一起忽略掉了，
#    导致 `cargo test` 的 3 条断言在新克隆上永久红。
/tests/fixtures/_bdo/*.class

# 编译后的 Java 探针产物
*.class
/out/

# 操作系统 / 编辑器
.DS_Store
Thumbs.db
*.swp

# web/（M4 前端）：依赖与构建产物不入库
/web/node_modules
/web/dist
# dev bin 产物（`rpx-server snapshot` 输出，可随时重生成）
/web/public/snapshot.json
# playwright 会话输出（验证用，可重生成）
/web/.playwright-cli

# 本机 agent 会话记忆（不入库）
.workbuddy-ai/
