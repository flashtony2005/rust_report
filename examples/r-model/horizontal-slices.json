{
  "version": 1,
  "grid": {
    "rows": 7,
    "cols": 7
  },
  "datasets": [
    {
      "name": "sales",
      "file": {
        "file_name": "sales.csv",
        "encoding": "UTF-8",
        "delimiter": ","
      }
    },
    {
      "name": "products",
      "file": {
        "file_name": "sources.xlsx",
        "encoding": "UTF-8",
        "sheet_name": "产品"
      }
    },
    {
      "name": "people",
      "file": {
        "file_name": "sources.xlsx",
        "encoding": "UTF-8",
        "sheet_name": "人员"
      }
    }
  ],
  "cells": [
    {
      "row": 1,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 18,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "销售额综合统计分析 · 横向分片",
      "merge": {
        "rows": 1,
        "cols": 7
      },
      "bold": true,
      "fore_color": "#163D46"
    },
    {
      "row": 2,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 9,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "与纵向分片使用相同数据；交换行列、主格和扩展方向，计算口径完全一致。",
      "merge": {
        "rows": 1,
        "cols": 7
      },
      "fore_color": "#52666E"
    },
    {
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "统计维度",
      "bold": true,
      "back_color": "#1B505B",
      "fore_color": "#FFFFFF",
      "h_align": "center",
      "row": 3,
      "col": 1,
      "merge": {
        "rows": 3,
        "cols": 1
      }
    },
    {
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "销售合计",
      "bold": true,
      "back_color": "#1B505B",
      "fore_color": "#FFFFFF",
      "h_align": "center",
      "row": 6,
      "col": 1
    },
    {
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "vertical",
      "expr": "products.select(category)",
      "h_align": "center",
      "format": "#,##0.00",
      "bold": true,
      "back_color": "#1B505B",
      "fore_color": "#FFFFFF",
      "row": 7,
      "col": 1
    },
    {
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "货主地区",
      "bold": true,
      "back_color": "#E8F2F1",
      "fore_color": "#163D46",
      "row": 3,
      "col": 2,
      "merge": {
        "rows": 2,
        "cols": 1
      }
    },
    {
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "horizontal",
      "expr": "sales.group(region)",
      "h_align": "left",
      "format": "#,##0.00",
      "row": 5,
      "col": 2
    },
    {
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "expr": "sales.sum(amount)",
      "h_align": "right",
      "format": "#,##0.00",
      "row": 6,
      "col": 2,
      "top_head": "B5"
    },
    {
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "expr": "sum(sales.select(amount,category==A7))",
      "h_align": "right",
      "format": "#,##0.00",
      "row": 7,
      "col": 2,
      "left_head": "A7",
      "top_head": "B5"
    },
    {
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "其中：货主地区不明",
      "row": 3,
      "col": 3,
      "merge": {
        "rows": 3,
        "cols": 1
      }
    },
    {
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "expr": "sum(sales.select(amount,region=='未分配'))",
      "h_align": "right",
      "format": "#,##0.00",
      "row": 6,
      "col": 3
    },
    {
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "expr": "sum(sales.select(amount,region=='未分配' and category==A7))",
      "h_align": "right",
      "format": "#,##0.00",
      "row": 7,
      "col": 3,
      "left_head": "A7"
    },
    {
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "销售人员",
      "bold": true,
      "back_color": "#E8F2F1",
      "fore_color": "#163D46",
      "row": 3,
      "col": 4
    },
    {
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "horizontal",
      "expr": "people.group(role)",
      "h_align": "left",
      "format": "#,##0.00",
      "row": 4,
      "col": 4
    },
    {
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "horizontal",
      "expr": "people.select(employee)",
      "h_align": "left",
      "format": "#,##0.00",
      "row": 5,
      "col": 4,
      "top_head": "D4"
    },
    {
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "expr": "sum(sales.select(amount,employee==D5))",
      "h_align": "right",
      "format": "#,##0.00",
      "row": 6,
      "col": 4,
      "top_head": "D5"
    },
    {
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "expr": "sum(sales.select(amount,employee==D5 and category==A7))",
      "h_align": "right",
      "format": "#,##0.00",
      "row": 7,
      "col": 4,
      "left_head": "A7",
      "top_head": "D5"
    },
    {
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "其中：无销售负责人的订单",
      "row": 3,
      "col": 5,
      "merge": {
        "rows": 3,
        "cols": 1
      }
    },
    {
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "expr": "sum(sales.select(amount,employee=='未分配'))",
      "h_align": "right",
      "format": "#,##0.00",
      "row": 6,
      "col": 5
    },
    {
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "expr": "sum(sales.select(amount,employee=='未分配' and category==A7))",
      "h_align": "right",
      "format": "#,##0.00",
      "row": 7,
      "col": 5,
      "left_head": "A7"
    },
    {
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "全部订单（独立合计）",
      "bold": true,
      "back_color": "#E8F2F1",
      "fore_color": "#163D46",
      "row": 3,
      "col": 6,
      "merge": {
        "rows": 3,
        "cols": 1
      }
    },
    {
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "expr": "sales.sum(amount)",
      "h_align": "right",
      "format": "#,##0.00",
      "bold": true,
      "back_color": "#E8F2F1",
      "fore_color": "#163D46",
      "row": 6,
      "col": 6
    },
    {
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "expr": "sum(sales.select(amount,category==A7))",
      "h_align": "right",
      "format": "#,##0.00",
      "bold": true,
      "back_color": "#E8F2F1",
      "fore_color": "#163D46",
      "row": 7,
      "col": 6,
      "left_head": "A7"
    }
  ],
