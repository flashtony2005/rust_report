{
  "version": 1,
  "grid": {
    "rows": 4,
    "cols": 8
  },
  "datasets": [
    {
      "name": "region",
      "file": {
        "file_name": "chart-region.csv",
        "encoding": "UTF-8",
        "delimiter": ","
      }
    }
  ],
  "cells": [
    {
      "row": 1,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 18,
      "v_align": "middle",
      "text": "ECharts option 模板 · 参数注入",
      "merge": {
        "rows": 1,
        "cols": 8
      },
      "bold": true,
      "fore_color": "#163D46"
    },
    {
      "row": 2,
      "col": 1,
      "font_size": 10,
      "v_align": "middle",
      "text": "总额",
      "h_align": "right",
      "fore_color": "#52666E"
    },
    {
      "row": 2,
      "col": 2,
      "font_size": 10,
      "v_align": "middle",
      "expr": "region.sum(amount)",
      "format": "#,##0.00",
      "bold": true,
      "fore_color": "#1B505B"
    },
    {
      "row": 2,
      "col": 3,
      "font_size": 10,
      "v_align": "middle",
      "text": "template 是 option JSON 文本；参数占位符插入的是 JSON 字面量，模板里不带引号。",
      "merge": {
        "rows": 1,
        "cols": 6
      },
      "fore_color": "#52666E"
    },
    {
      "row": 3,
      "col": 1,
      "data_type": "echarts",
      "echarts": {
        "width": 900,
        "height": 380,
        "template": "{\"backgroundColor\":\"transparent\",\"title\":{\"text\":${title},\"subtext\":\"option JSON 由参数注入生成\",\"left\":\"center\"},\"tooltip\":{\"trigger\":\"axis\"},\"grid\":{\"left\":70,\"right\":30,\"top\":80,\"bottom\":40},\"xAxis\":{\"type\":\"category\",\"data\":${cats},\"axisTick\":{\"alignWithLabel\":true}},\"yAxis\":{\"type\":\"value\",\"splitLine\":{\"lineStyle\":{\"color\":\"#eef3f1\"}}},\"series\":[{\"type\":\"bar\",\"data\":${vals},\"barWidth\":\"46%\",\"itemStyle\":{\"color\":\"#215951\",\"borderRadius\":[4,4,0,0]},\"label\":{\"show\":true,\"position\":\"top\",\"color\":\"#245a55\"}}]}",
        "params": {
          "title": "='各地区销售额 · ECharts option 模板'",
          "cats": "=region.select(region)",
          "vals": "=region.select(amount)"
        }
      }
    }
  ],
  "row_props": [
    {
      "row": 1,
      "height": 44
    },
    {
      "row": 2,
      "height": 22
    },
    {
      "row": 3,
      "height": 400
    },
    {
      "row": 4,
      "height": 40
    }
  ],
  "col_props": [
    {
      "col": 1,
      "width": 130
    },
    {
      "col": 2,
      "width": 130
    },
    {
      "col": 3,
      "width": 130
    },
    {
      "col": 4,
      "width": 130
    },
    {
      "col": 5,
      "width": 130
    },
    {
      "col": 6,
      "width": 130
    },
    {
      "col": 7,
      "width": 130
    },
    {
      "col": 8,
      "width": 130
    }
  ],
  "print_setup": {
    "paper_width": 420,
    "paper_height": 297,
    "left_margin": 10,
    "right_margin": 10,
    "top_margin": 10,
    "bottom_margin": 10
  },
  "printing": {
    "horizontal_split": false,
    "vertical_split": false,
    "border_width": 0.5,
    "border_color": "#CBD5E1"
  }
}
