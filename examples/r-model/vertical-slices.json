{
  "version": 1,
  "grid": {
    "rows": 9,
    "cols": 5
  },
  "datasets": [
    {
      "name": "sales",
      "file": {
        "file_name": "sales.csv",
        "encoding": "UTF-8",
        "delimiter": ","
      }
    },
    {
      "name": "products",
      "file": {
        "file_name": "sources.xlsx",
        "encoding": "UTF-8",
        "sheet_name": "产品"
      }
    },
    {
      "name": "people",
      "file": {
        "file_name": "sources.xlsx",
        "encoding": "UTF-8",
        "sheet_name": "人员"
      }
    }
  ],
  "cells": [
    {
      "row": 1,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 18,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "销售额综合统计分析 · 纵向分片",
      "merge": {
        "rows": 1,
        "cols": 5
      },
      "bold": true,
      "fore_color": "#163D46"
    },
    {
      "row": 2,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 9,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "CSV 销售明细 + Excel 产品 / 人员；地区与人员分别统计，同一事实不会将两个口径再相加。",
      "merge": {
        "rows": 1,
        "cols": 5
      },
      "fore_color": "#52666E"
    },
    {
      "row": 3,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "统计维度",
      "bold": true,
      "back_color": "#1B505B",
      "fore_color": "#FFFFFF",
      "h_align": "center",
      "merge": {
        "rows": 1,
        "cols": 3
      }
    },
    {
      "row": 3,
      "col": 4,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "销售合计",
      "bold": true,
      "back_color": "#1B505B",
      "fore_color": "#FFFFFF",
      "h_align": "center"
    },
    {
      "row": 3,
      "col": 5,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "horizontal",
      "expr": "products.select(category)",
      "h_align": "center",
      "format": "#,##0.00",
      "bold": true,
      "back_color": "#1B505B",
      "fore_color": "#FFFFFF"
    },
    {
      "row": 4,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "货主地区",
      "bold": true,
      "back_color": "#E8F2F1",
      "fore_color": "#163D46",
      "merge": {
        "rows": 1,
        "cols": 2
      }
    },
    {
      "row": 4,
      "col": 3,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "vertical",
      "expr": "sales.group(region)",
      "h_align": "left",
      "format": "#,##0.00"
    },
    {
      "row": 4,
      "col": 4,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "left_head": "C4",
      "expr": "sales.sum(amount)",
      "h_align": "right",
      "format": "#,##0.00"
    },
    {
      "row": 4,
      "col": 5,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "left_head": "C4",
      "top_head": "E3",
      "expr": "sum(sales.select(amount,category==E3))",
      "h_align": "right",
      "format": "#,##0.00"
    },
    {
      "row": 5,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "其中：货主地区不明",
      "merge": {
        "rows": 1,
        "cols": 3
      }
    },
    {
      "row": 5,
      "col": 4,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "expr": "sum(sales.select(amount,region=='未分配'))",
      "h_align": "right",
      "format": "#,##0.00"
    },
    {
      "row": 5,
      "col": 5,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "top_head": "E3",
      "expr": "sum(sales.select(amount,region=='未分配' and category==E3))",
      "h_align": "right",
      "format": "#,##0.00"
    },
    {
      "row": 6,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "销售人员",
      "bold": true,
      "back_color": "#E8F2F1",
      "fore_color": "#163D46"
    },
    {
      "row": 6,
      "col": 2,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "vertical",
      "expr": "people.group(role)",
      "h_align": "left",
      "format": "#,##0.00"
    },
    {
      "row": 6,
      "col": 3,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "vertical",
      "left_head": "B6",
      "expr": "people.select(employee)",
      "h_align": "left",
      "format": "#,##0.00"
    },
    {
      "row": 6,
      "col": 4,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "left_head": "C6",
      "expr": "sum(sales.select(amount,employee==C6))",
      "h_align": "right",
      "format": "#,##0.00"
    },
    {
      "row": 6,
      "col": 5,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "left_head": "C6",
      "top_head": "E3",
      "expr": "sum(sales.select(amount,employee==C6 and category==E3))",
      "h_align": "right",
      "format": "#,##0.00"
    },
    {
      "row": 7,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "其中：无销售负责人的订单",
      "merge": {
        "rows": 1,
        "cols": 3
      }
    },
    {
      "row": 7,
      "col": 4,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "expr": "sum(sales.select(amount,employee=='未分配'))",
      "h_align": "right",
      "format": "#,##0.00"
    },
    {
      "row": 7,
      "col": 5,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "top_head": "E3",
      "expr": "sum(sales.select(amount,employee=='未分配' and category==E3))",
      "h_align": "right",
      "format": "#,##0.00"
    },
    {
      "row": 8,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "全部订单（独立合计）",
      "bold": true,
      "back_color": "#E8F2F1",
      "fore_color": "#163D46",
      "merge": {
        "rows": 1,
        "cols": 3
      }
    },
    {
      "row": 8,
      "col": 4,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "expr": "sales.sum(amount)",
      "h_align": "right",
      "format": "#,##0.00",
      "bold": true,
      "back_color": "#E8F2F1",
      "fore_color": "#163D46"
    },
    {
      "row": 8,
      "col": 5,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "top_head": "E3",
      "expr": "sum(sales.select(amount,category==E3))",
      "h_align": "right",
      "format": "#,##0.00",
      "bold": true,
      "back_color": "#E8F2F1",
      "fore_color": "#163D46"
    },
    {
      "row": 9,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "“其中”行重复引用同一事实；全部订单合计直接取原始数据。",
      "merge": {
        "rows": 1,
        "cols": 5
      }
    }
  ],
