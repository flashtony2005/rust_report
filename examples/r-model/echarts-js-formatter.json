{
  "version": 1,
  "grid": {
    "rows": 4,
    "cols": 8
  },
  "datasets": [
    {
      "name": "region",
      "file": {
        "file_name": "chart-region.csv",
        "encoding": "UTF-8",
        "delimiter": ","
      }
    }
  ],
  "cells": [
    {
      "row": 1,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 18,
      "v_align": "middle",
      "merge": {
        "rows": 1,
        "cols": 8
      },
      "bold": true,
      "fore_color": "#163D46",
      "text": "ECharts JavaScript 模板 · formatter 回调"
    },
    {
      "row": 2,
      "col": 1,
      "font_size": 10,
      "v_align": "middle",
      "text": "地区数",
      "h_align": "right",
      "fore_color": "#52666E"
    },
    {
      "row": 2,
      "col": 2,
      "font_size": 10,
      "v_align": "middle",
      "expr": "region.count()",
      "format": "0",
      "bold": true,
      "fore_color": "#1B505B"
    },
    {
      "row": 2,
      "col": 3,
      "font_size": 10,
      "v_align": "middle",
      "text": "template 是 JS 函数体，在 sandbox iframe 里执行；formatter 是真正的函数，不是字符串。",
      "merge": {
        "rows": 1,
        "cols": 6
      },
      "fore_color": "#52666E"
    },
    {
      "row": 3,
      "col": 1,
      "data_type": "echarts_js",
      "echarts": {
        "width": 900,
        "height": 380,
        "template": "var names = ${cats};\nvar values = ${vals};\nvar total = 0;\nfor (var i = 0; i < values.length; i++) { total += values[i]; }\nreturn {\n  title: { text: ${title}, subtext: '合计 ' + total + ' 元', left: 'center' },\n  tooltip: { trigger: 'item', formatter: function (p) { return p.name + '：' + p.value + ' 元（' + p.percent + '%）'; } },\n  legend: { bottom: 0 },\n  series: [{\n    type: 'pie',\n    radius: ['38%', '64%'],\n    center: ['50%', '46%'],\n    label: { formatter: function (p) { return p.name + '\\n' + p.percent + '%'; } },\n    data: names.map(function (n, i) { return { name: n, value: values[i] }; })\n  }]\n};",
        "params": {
          "title": "=\"地区金额占比 · JS 模板\"",
          "cats": "=region.select(region)",
          "vals": "=region.select(amount)"
        }
      }
    }
  ],
  "row_props": [
    {
      "row": 1,
      "height": 44
    },
    {
      "row": 2,
      "height": 22
    },
    {
      "row": 3,
      "height": 400
    },
    {
      "row": 4,
      "height": 40
    }
  ],
  "col_props": [
    {
      "col": 1,
      "width": 130
    },
    {
      "col": 2,
      "width": 130
    },
    {
      "col": 3,
      "width": 130
    },
    {
      "col": 4,
      "width": 130
    },
    {
      "col": 5,
      "width": 130
    },
    {
      "col": 6,
      "width": 130
    },
    {
      "col": 7,
      "width": 130
    },
    {
      "col": 8,
      "width": 130
    }
  ],
  "print_setup": {
    "paper_width": 420,
    "paper_height": 297,
    "left_margin": 10,
    "right_margin": 10,
    "top_margin": 10,
    "bottom_margin": 10
  },
  "printing": {
    "horizontal_split": false,
    "vertical_split": false,
    "border_width": 0.5,
    "border_color": "#CBD5E1"
  }
}
