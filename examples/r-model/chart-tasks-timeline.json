{
  "version": 1,
  "grid": {
    "rows": 6,
    "cols": 8
  },
  "datasets": [
    {
      "name": "tasks",
      "file": {
        "file_name": "chart-tasks.csv",
        "encoding": "UTF-8",
        "delimiter": ","
      }
    }
  ],
  "cells": [
    {
      "row": 1,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 18,
      "v_align": "middle",
      "text": "项目排期 · 甘特 / 状态时间线 / 里程碑",
      "merge": {
        "rows": 1,
        "cols": 8
      },
      "bold": true,
      "fore_color": "#163D46"
    },
    {
      "row": 2,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "text": "任务数",
      "h_align": "right",
      "fore_color": "#52666E"
    },
    {
      "row": 2,
      "col": 2,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "expr": "tasks.count()",
      "format": "0",
      "bold": true,
      "fore_color": "#1B505B"
    },
    {
      "row": 2,
      "col": 3,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "text": "三种任务图共用同一份 tasks 绑定：起止时间 + 状态。",
      "merge": {
        "rows": 1,
        "cols": 6
      },
      "fore_color": "#52666E"
    },
    {
      "row": 3,
      "col": 1,
      "data_type": "chart",
      "chart": {
        "type": "gantt",
        "title": "甘特图",
        "width": 900,
        "height": 190,
        "tasks": {
          "categories": "=tasks.select(task)",
          "starts": "=tasks.select(start)",
          "ends": "=tasks.select(end)",
          "states": "=tasks.select(state)"
        },
        "appearance": {
          "colors": [
            "#215951",
            "#4f9a86",
            "#a8cbbb"
          ],
          "legend": "top",
          "margins": [
            48,
            30,
            26,
            110
          ]
        }
      }
    },
    {
      "row": 4,
      "col": 1,
      "data_type": "chart",
      "chart": {
        "type": "state_timeline",
        "title": "状态时间线",
        "width": 900,
        "height": 190,
        "tasks": {
          "categories": "=tasks.select(task)",
          "starts": "=tasks.select(start)",
          "ends": "=tasks.select(end)",
          "states": "=tasks.select(state)"
        },
        "appearance": {
          "colors": [
            "#d98b4a",
            "#215951",
            "#8d9a9e"
          ],
          "legend": "top",
          "margins": [
            48,
            30,
            26,
            110
          ]
        }
      }
    },
    {
      "row": 5,
      "col": 1,
      "data_type": "chart",
      "chart": {
        "type": "milestone",
        "title": "里程碑（只给起点，不给终点）",
        "width": 900,
        "height": 190,
        "tasks": {
          "categories": "=tasks.select(task)",
          "starts": "=tasks.select(start)"
        },
        "appearance": {
          "colors": [
            "#215951",
            "#4f9a86"
          ],
          "legend": "none",
          "margins": [
            48,
            30,
            26,
            110
          ]
        }
      }
    }
  ],
  "row_props": [
    {
      "row": 1,
      "height": 44
    },
    {
      "row": 2,
      "height": 22
    },
    {
      "row": 3,
      "height": 210
    },
    {
      "row": 4,
      "height": 210
    },
    {
      "row": 5,
      "height": 210
    },
    {
      "row": 6,
      "height": 40
    }
  ],
  "col_props": [
    {
      "col": 1,
      "width": 130
    },
    {
      "col": 2,
      "width": 130
    },
    {
      "col": 3,
      "width": 130
    },
    {
      "col": 4,
      "width": 130
    },
    {
      "col": 5,
      "width": 130
    },
    {
      "col": 6,
      "width": 130
    },
    {
      "col": 7,
      "width": 130
    },
    {
      "col": 8,
      "width": 130
    }
  ],
  "print_setup": {
    "paper_width": 420,
    "paper_height": 297,
    "left_margin": 10,
    "right_margin": 10,
    "top_margin": 10,
    "bottom_margin": 10
  },
  "printing": {
    "horizontal_split": false,
    "vertical_split": false,
    "border_width": 0.5,
    "border_color": "#CBD5E1"
  }
}
