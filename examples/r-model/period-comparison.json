{
  "version": 1,
  "grid": {
    "rows": 6,
    "cols": 6
  },
  "datasets": [
    {
      "name": "contracts",
      "file": {
        "file_name": "contracts.csv",
        "encoding": "UTF-8",
        "delimiter": ","
      }
    }
  ],
  "cells": [
    {
      "row": 1,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 18,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "历年签约对比 · 同比与环比",
      "merge": {
        "rows": 1,
        "cols": 6
      },
      "bold": true,
      "fore_color": "#163D46"
    },
    {
      "row": 2,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 9,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "比值口径为本期 / 基期；第一期无可比值、基期为零均明确显示，跨年度环比连续计算。",
      "merge": {
        "rows": 1,
        "cols": 6
      },
      "fore_color": "#52666E"
    },
    {
      "row": 3,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "年度",
      "bold": true,
      "back_color": "#1B505B",
      "fore_color": "#FFFFFF",
      "h_align": "center"
    },
    {
      "row": 3,
      "col": 2,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "季度",
      "bold": true,
      "back_color": "#1B505B",
      "fore_color": "#FFFFFF",
      "h_align": "center"
    },
    {
      "row": 3,
      "col": 3,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "当期合同额",
      "bold": true,
      "back_color": "#1B505B",
      "fore_color": "#FFFFFF",
      "h_align": "center"
    },
    {
      "row": 3,
      "col": 4,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "环比（本期 / 上期）",
      "bold": true,
      "back_color": "#1B505B",
      "fore_color": "#FFFFFF",
      "h_align": "center"
    },
    {
      "row": 3,
      "col": 5,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "同比（本期 / 去年同季）",
      "bold": true,
      "back_color": "#1B505B",
      "fore_color": "#FFFFFF",
      "h_align": "center"
    },
    {
      "row": 3,
      "col": 6,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "累计签约额",
      "bold": true,
      "back_color": "#1B505B",
      "fore_color": "#FFFFFF",
      "h_align": "center"
    },
    {
      "row": 4,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "vertical",
      "expr": "contracts.select(year)",
      "h_align": "center",
      "format": "0",
      "merge_same": "vertical"
    },
    {
      "row": 4,
      "col": 2,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "left_head": "A4",
      "expr": "contracts.quarter",
      "h_align": "right",
      "format": "0"
    },
    {
      "row": 4,
      "col": 3,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "left_head": "A4",
      "expr": "contracts.amount",
      "h_align": "right",
      "format": "#,##0.00"
    },
    {
      "row": 4,
      "col": 4,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "left_head": "A4",
      "expr": "if(seq(A4)<=1,'—',if(C4[-1]==0,'基期为零',C4/C4[-1]))",
      "h_align": "right",
      "format": "0.00%"
    },
    {
      "row": 4,
      "col": 5,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "left_head": "A4",
      "expr": "if(seq(A4)<=4,'—',if(C4[-4]==0,'基期为零',C4/C4[-4]))",
      "h_align": "right",
      "format": "0.00%"
    },
    {
      "row": 4,
      "col": 6,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "left_head": "A4",
      "expr": "C4+F4[-1]",
      "h_align": "right",
      "format": "#,##0.00"
    },
    {
      "row": 5,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "合同合计",
      "bold": true,
      "back_color": "#E8F2F1",
      "fore_color": "#163D46",
      "merge": {
        "rows": 1,
        "cols": 2
      }
    },
    {
      "row": 5,
      "col": 3,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "expr": "contracts.sum(amount)",
      "h_align": "right",
      "format": "#,##0.00",
      "bold": true,
      "back_color": "#E8F2F1",
      "fore_color": "#163D46"
    },
    {
      "row": 6,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "2025 Q1 环比引用 2024 Q4；2026 Q4 同比基期为零，不产生 Infinity。",
      "merge": {
        "rows": 1,
        "cols": 6
      }
    }
  ],
  "row_props": [
    {
      "row": 1,
      "height": 12
    },
    {
      "row": 2,
      "height": 9
    },
    {
      "row": 3,
      "height": 8
    },
    {
      "row": 4,
      "height": 8
    },
    {
      "row": 5,
      "height": 8
    },
    {
      "row": 6,
      "height": 8
    }
  ],
  "col_props": [
    {
      "col": 1,
      "width": 32
    },
    {
      "col": 2,
      "width": 32
    },
    {
      "col": 3,
      "width": 29
    },
    {
      "col": 4,
      "width": 47
    },
    {
      "col": 5,
      "width": 47
    },
    {
      "col": 6,
      "width": 29
    }
  ],
  "print_setup": {
    "paper_width": 420,
    "paper_height": 297,
    "left_margin": 10,
    "right_margin": 10,
    "top_margin": 10,
    "bottom_margin": 10
  },
  "printing": {
    "horizontal_split": false,
    "vertical_split": false,
    "border_width": 0.5,
    "border_color": "#CBD5E1"
  }
}
