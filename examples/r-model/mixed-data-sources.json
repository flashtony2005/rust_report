{
  "version": 1,
  "grid": {
    "rows": 6,
    "cols": 9
  },
  "datasets": [
    {
      "name": "organization",
      "sql": {
        "dsn": "organization-db",
        "sql": "SELECT region, owner FROM organization ORDER BY display_order"
      }
    },
    {
      "name": "actuals",
      "sql": {
        "dsn": "operations-db",
        "sql": "SELECT region, revenue, cost FROM ledger ORDER BY rowid"
      }
    },
    {
      "name": "budget",
      "file": {
        "file_name": "sources.xlsx",
        "encoding": "UTF-8",
        "sheet_name": "预算"
      }
    },
    {
      "name": "refunds",
      "file": {
        "file_name": "refunds.csv",
        "encoding": "UTF-8",
        "delimiter": ","
      }
    }
  ],
  "cells": [
    {
      "row": 1,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 18,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "经营实绩联查 · Excel + CSV + 双数据库",
      "merge": {
        "rows": 1,
        "cols": 9
      },
      "bold": true,
      "fore_color": "#163D46"
    },
    {
      "row": 2,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 9,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "Excel 预算 + CSV 退款 + 经营库实绩 + 组织库负责人；四个数据集通过区域键在报表中关联。",
      "merge": {
        "rows": 1,
        "cols": 9
      },
      "fore_color": "#52666E"
    },
    {
      "row": 3,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "区域",
      "bold": true,
      "back_color": "#1B505B",
      "fore_color": "#FFFFFF",
      "h_align": "center"
    },
    {
      "row": 3,
      "col": 2,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
