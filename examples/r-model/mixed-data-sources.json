      "bold": true,
      "back_color": "#1B505B",
      "fore_color": "#FFFFFF",
      "h_align": "center"
    },
    {
      "row": 4,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "vertical",
      "expr": "organization.select(region)",
      "h_align": "left",
      "format": "#,##0.00"
    },
    {
      "row": 4,
      "col": 2,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "left_head": "A4",
      "expr": "organization.owner",
      "h_align": "right",
      "format": "#,##0.00"
    },
    {
      "row": 4,
      "col": 3,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "left_head": "A4",
      "expr": "sum(budget.select(budget,region==A4))",
      "h_align": "right",
      "format": "#,##0.00"
    },
    {
      "row": 4,
      "col": 4,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "left_head": "A4",
      "expr": "sum(actuals.select(revenue,region==A4))",
      "h_align": "right",
      "format": "#,##0.00"
    },
    {
      "row": 4,
      "col": 5,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "left_head": "A4",
      "expr": "sum(refunds.select(amount,region==A4))",
      "h_align": "right",
      "format": "#,##0.00"
    },
    {
      "row": 4,
      "col": 6,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "left_head": "A4",
      "expr": "D4-E4",
      "h_align": "right",
      "format": "#,##0.00"
    },
    {
      "row": 4,
      "col": 7,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "left_head": "A4",
      "expr": "sum(actuals.select(cost,region==A4))",
      "h_align": "right",
      "format": "#,##0.00"
    },
    {
      "row": 4,
      "col": 8,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "left_head": "A4",
      "expr": "F4-G4",
      "h_align": "right",
      "format": "#,##0.00"
    },
    {
      "row": 4,
      "col": 9,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "left_head": "A4",
      "expr": "if(C4==0,0,F4/C4)",
      "h_align": "right",
      "format": "0.00%"
    },
    {
      "row": 5,
      "col": 1,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "合计",
      "bold": true,
      "back_color": "#E8F2F1",
      "fore_color": "#163D46",
      "merge": {
        "rows": 1,
        "cols": 2
      }
    },
    {
      "row": 5,
      "col": 3,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "expr": "budget.sum(budget)",
      "h_align": "right",
      "format": "#,##0.00",
      "bold": true,
      "back_color": "#E8F2F1",
      "fore_color": "#163D46"
    },
    {
      "row": 5,
      "col": 4,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "expr": "actuals.sum(revenue)",
      "h_align": "right",
      "format": "#,##0.00",
      "bold": true,
      "back_color": "#E8F2F1",
      "fore_color": "#163D46"
    },
    {
      "row": 5,
      "col": 5,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "expr": "refunds.sum(amount)",
      "h_align": "right",
      "format": "#,##0.00",
      "bold": true,
      "back_color": "#E8F2F1",
      "fore_color": "#163D46"
    },
    {
      "row": 5,
      "col": 6,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "expr": "D5-E5",
      "h_align": "right",
      "format": "#,##0.00",
      "bold": true,
      "back_color": "#E8F2F1",
      "fore_color": "#163D46"
    },
    {
      "row": 5,
      "col": 7,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "expr": "actuals.sum(cost)",
      "h_align": "right",
      "format": "#,##0.00",
      "bold": true,
      "back_color": "#E8F2F1",
      "fore_color": "#163D46"
    },
    {
      "row": 5,
      "col": 8,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "expr": "F5-G5",
      "h_align": "right",
      "format": "#,##0.00",
      "bold": true,
      "back_color": "#E8F2F1",
      "fore_color": "#163D46"
    },
    {
      "row": 5,
      "col": 9,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "expr": "F5/C5",
      "h_align": "right",
      "format": "0.00%",
      "bold": true,
      "back_color": "#E8F2F1",
      "fore_color": "#163D46"
