      "bold": true,
      "back_color": "#1B505B",
      "fore_color": "#FFFFFF",
      "h_align": "center"
    },
    {
      "row": 3,
      "col": 6,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "净收入",
      "bold": true,
      "back_color": "#1B505B",
      "fore_color": "#FFFFFF",
      "h_align": "center"
    },
    {
      "row": 3,
      "col": 7,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "数据库成本",
      "bold": true,
      "back_color": "#1B505B",
      "fore_color": "#FFFFFF",
      "h_align": "center"
    },
    {
      "row": 3,
      "col": 8,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
      "text": "毛利",
      "bold": true,
      "back_color": "#1B505B",
      "fore_color": "#FFFFFF",
      "h_align": "center"
    },
    {
      "row": 3,
      "col": 9,
      "font_name": "Microsoft YaHei",
      "font_size": 10,
      "v_align": "middle",
      "extend_mode": "none",
