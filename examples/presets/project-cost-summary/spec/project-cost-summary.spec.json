{
  "schema": "rpx-spec/v1",
  "title": "项目成本汇总表",
  "dataset": {
    "name": "d",
    "file": "sample.csv"
  },
  "layout": "grouped",
  "row_dims": [
    {
      "field": "project",
      "label": "项目",
      "sort": "asc"
    }
  ],
  "measures": [
    {
      "field": "budget",
      "agg": "sum",
      "label": "预算",
      "format": "#,##0"
    },
    {
      "field": "actual_cost",
      "agg": "sum",
      "label": "实际成本",
      "format": "#,##0"
    }
  ],
  "totals": {
    "grand": true
  }
}
