{
  "schema": "rpx-spec/v1",
  "title": "费用类别分析表",
  "dataset": {
    "name": "d",
    "file": "sample.csv"
  },
  "layout": "grouped",
  "row_dims": [
    {
      "field": "department",
      "label": "部门",
      "sort": "asc"
    },
    {
      "field": "category",
      "label": "费用类别",
      "sort": "asc"
    }
  ],
  "measures": [
    {
      "field": "expense",
      "agg": "sum",
      "label": "支出",
      "format": "#,##0.00"
    }
  ],
  "totals": {
    "grand": true
  }
}
