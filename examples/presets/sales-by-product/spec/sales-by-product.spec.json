{
  "schema": "rpx-spec/v1",
  "title": "产品销售汇总表",
  "dataset": {
    "name": "d",
    "file": "sample.csv"
  },
  "layout": "grouped",
  "row_dims": [
    {
      "field": "product",
      "label": "产品",
      "sort": "asc"
    }
  ],
  "measures": [
    {
      "field": "quantity",
      "agg": "sum",
      "label": "销量",
      "format": "#,##0"
    },
    {
      "field": "amount",
      "agg": "sum",
      "label": "销售额",
      "format": "#,##0.00"
    }
  ],
  "totals": {
    "grand": true
  }
}
