{
  "schema": "rpx-spec/v1",
  "title": "商品库存汇总表",
  "dataset": {
    "name": "d",
    "file": "sample.csv"
  },
  "layout": "grouped",
  "row_dims": [
    {
      "field": "product",
      "label": "商品",
      "sort": "asc"
    }
  ],
  "measures": [
    {
      "field": "quantity",
      "agg": "sum",
      "label": "库存数量",
      "format": "#,##0"
    }
  ],
  "totals": {
    "grand": true
  }
}
