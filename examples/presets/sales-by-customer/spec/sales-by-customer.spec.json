{
  "schema": "rpx-spec/v1",
  "title": "客户销售排行表",
  "dataset": {
    "name": "d",
    "file": "sample.csv"
  },
  "layout": "grouped",
  "row_dims": [
    {
      "field": "customer",
      "label": "客户",
      "sort": "asc"
    }
  ],
  "measures": [
    {
      "field": "amount",
      "agg": "sum",
      "label": "销售额",
      "format": "#,##0.00"
    }
  ],
  "totals": {
    "grand": true
  }
}
